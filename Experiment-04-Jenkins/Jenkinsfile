pipeline {
  agent any
  stages {
    stage('Generate site') {
      steps {
        sh 'mkdir -p site'
        writeFile file: 'site/index.html', text: '<h1>Karunya University</h1><p>Generated by Jenkins</p>'
      }
    }
    stage('Publish site') {
      steps {
        publishHTML([allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true,
          reportDir: 'site', reportFiles: 'index.html', reportName: 'Karunya Site'])
      }
    }
  }
}
